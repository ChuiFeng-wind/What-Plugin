<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>1.3.0</Version>
    <Product>WhatPlugin</Product>
    <Company>WhatPlugin</Company>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WhatPlugin.Core\WhatPlugin.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\build\scanner\Release\WhatPluginScanner.exe')">
    <None Include="..\..\build\scanner\Release\WhatPluginScanner.exe" Link="WhatPluginScanner.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\build\scanner\WhatPluginScanner_artefacts\Release\WhatPluginScanner.exe')">
    <None Include="..\..\build\scanner\WhatPluginScanner_artefacts\Release\WhatPluginScanner.exe" Link="WhatPluginScanner.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
