<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- 核心库要能在 Mac 上用：调用 Windows 专用接口而没有判断平台时编译失败。 -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\plugin-seed.json" />
    <EmbeddedResource Include="Data\need-terms.json" />
    <EmbeddedResource Include="Data\vendor-catalog.json" />
  </ItemGroup>
</Project>
