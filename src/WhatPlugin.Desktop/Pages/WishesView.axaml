<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:core="clr-namespace:WhatPlugin.Core;assembly=WhatPlugin.Core"
             x:Class="WhatPlugin.Desktop.WishesView">
    <UserControl.Styles>
        <Style Selector="Border.Badge">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
    <!-- 和 Windows 版一样：左边是心愿列表（上面一行快速加入），右边是选中的那一款。买了之后转到已购账号。 -->
    <Grid ColumnDefinitions="*,14,400" Margin="0,0,0,18">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <TextBox x:Name="QuickAddBox" PlaceholderText="输入想买的插件名，回车加入" AutomationProperties.Name="想买的插件名"/>
                <Button x:Name="QuickAddButton" Grid.Column="1" Classes="Primary" Margin="8,0,0,0" AutomationProperties.Name="加入心愿单">
                    <StackPanel Orientation="Horizontal"><mi:MaterialIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="加入心愿单"/></StackPanel>
                </Button>
            </Grid>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,140" Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" PlaceholderText="搜索插件名、厂家、原因或备注" AutomationProperties.Name="搜索心愿单"/>
                <ComboBox x:Name="SortBox" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch" AutomationProperties.Name="排序"/>
            </Grid>
            <Border Classes="Card" ClipToBounds="True">
                <Panel>
                    <ListBox x:Name="WishList" Classes="Plugins" AutomationProperties.Name="心愿单">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:WishRow">
                                <DockPanel Margin="14,10" Background="Transparent">
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding PriceText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding PriorityText}" Classes="SmallNote" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                            <Border Classes="Badge" Background="{DynamicResource GoodSoft}" IsVisible="{Binding IsInstalled}">
                                                <TextBlock Text="已安装" FontSize="11" Foreground="{DynamicResource Good}"/>
                                            </Border>
                                            <Border Classes="Badge" Background="{DynamicResource AccentSoft}" IsVisible="{Binding ReachedTarget}">
                                                <TextBlock Text="到目标价" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding VendorText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ReasonLine}" Foreground="{DynamicResource TextDim}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                        <mi:MaterialIcon Kind="HeartOutline" Width="36" Height="36" Foreground="{DynamicResource LineStrong}"/>
                        <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Panel>
            </Border>
        </DockPanel>

        <!-- 右：详情 -->
        <Border Grid.Column="2" Classes="Card" ClipToBounds="True">
            <Panel>
                <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300">
                    <mi:MaterialIcon Kind="HeartOutline" Width="34" Height="34" Foreground="{DynamicResource LineStrong}"/>
                    <TextBlock x:Name="DetailEmptyText" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
                <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <StackPanel Margin="20,18,18,20">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button x:Name="BoughtButton" Classes="Primary" Margin="0,0,6,0" AutomationProperties.Name="标记为已买"
                                    ToolTip.Tip="移到已购账号，原因和价格都留着">
                                <StackPanel Orientation="Horizontal"><mi:MaterialIcon Kind="CheckBold" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="标记为已买"/></StackPanel>
                            </Button>
                            <Button x:Name="DeleteButton" Classes="Ghost" AutomationProperties.Name="删除">
                                <StackPanel Orientation="Horizontal"><mi:MaterialIcon Kind="DeleteOutline" Width="15" Height="15" Margin="0,0,6,0" Foreground="{DynamicResource Danger}"/><TextBlock Text="删除" Foreground="{DynamicResource Danger}"/></StackPanel>
                            </Button>
                        </WrapPanel>

                        <Border x:Name="TrashNote" Background="{DynamicResource DangerSoft}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0" IsVisible="False">
                            <TextBlock x:Name="TrashText" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="插件名" Classes="FieldLabel" Margin="0,14,0,4"/>
                        <TextBox x:Name="NameBox" AutomationProperties.Name="插件名"/>
                        <TextBlock Text="厂家" Classes="FieldLabel" Margin="0,12,0,4"/>
                        <AutoCompleteBox x:Name="VendorBox" PlaceholderText="输入首字母，从列表里选" FilterMode="None" MinimumPrefixLength="1" MinimumPopulateDelay="0"
                                         AutomationProperties.Name="厂家"/>

                        <TextBlock Text="同类" Classes="FieldLabel" Margin="0,12,0,4"/>
                        <ComboBox x:Name="CategoryBox" HorizontalAlignment="Stretch" AutomationProperties.Name="同类"/>
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                            <TextBlock x:Name="AdviceBlock" TextWrapping="Wrap" LineHeight="20"/>
                        </Border>

                        <TextBlock Text="价格" Classes="FieldLabel" Margin="0,12,0,4"/>
                        <Grid ColumnDefinitions="72,*,Auto">
                            <ComboBox x:Name="CurrencyBox" HorizontalAlignment="Stretch" AutomationProperties.Name="币种"/>
                            <TextBox x:Name="PriceBox" Grid.Column="1" Margin="6,0,0,0" PlaceholderText="例如 1299 或 29.99" AutomationProperties.Name="价格"/>
                            <Button x:Name="PriceSearchButton" Grid.Column="2" Classes="Ghost" Margin="6,0,0,0" ToolTip.Tip="用浏览器搜一下现价，软件自己不联网抓价格">
                                <StackPanel Orientation="Horizontal"><mi:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="0,0,4,0"/><TextBlock Text="查价"/></StackPanel>
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,10,*" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="目标价" Classes="FieldLabel" Margin="0,0,0,4"/>
                                <TextBox x:Name="TargetBox" PlaceholderText="降到多少就买" AutomationProperties.Name="目标价"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="历史最低价" Classes="FieldLabel" Margin="0,0,0,4"/>
                                <TextBox x:Name="LowestBox" PlaceholderText="手动记录" AutomationProperties.Name="历史最低价"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="PriceHint" Classes="SmallNote" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <TextBlock Text="想要程度" Classes="FieldLabel" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="MustHave" Classes="Segment" GroupName="WishPriority" Content="势在必得" MinWidth="86" Margin="0,0,6,0"/>
                            <RadioButton x:Name="CanWait" Classes="Segment" GroupName="WishPriority" Content="我还能忍" MinWidth="86"/>
                        </StackPanel>

                        <TextBlock Text="为什么想买" Classes="FieldLabel" Margin="0,12,0,4"/>
                        <TextBox x:Name="ReasonBox" Classes="Multiline" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                 PlaceholderText="想解决什么问题，听谁推荐的…" AutomationProperties.Name="为什么想买"/>

                        <TextBlock Text="购买链接" Classes="FieldLabel" Margin="0,12,0,4"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="UrlBox" AutomationProperties.Name="购买链接"/>
                            <Button x:Name="OpenUrlButton" Grid.Column="1" Classes="Ghost" Margin="6,0,0,0" ToolTip.Tip="用浏览器打开" AutomationProperties.Name="打开购买链接">
                                <mi:MaterialIcon Kind="OpenInNew" Width="15" Height="15"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="备注" Classes="FieldLabel" Margin="0,12,0,4"/>
                        <TextBox x:Name="NoteBox" Classes="Multiline" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52"
                                 PlaceholderText="例如：等黑五打折" AutomationProperties.Name="备注"/>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>
    </Grid>
</UserControl>
