<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="WhatPlugin.Desktop.MainWindow"
        Title="WhatPlugin" Width="1400" Height="860" MinWidth="1120" MinHeight="640"
        Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="avares://WhatPlugin.Desktop/Assets/app.ico">

    <Grid x:Name="RootFrame" ColumnDefinitions="220,*">

        <!-- 侧边栏 -->
        <Border Background="{DynamicResource Bg0}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,0,14,14">
                <!-- 顶部空白可以拖动窗口；Mac 上左上角是系统的红黄绿按钮，标志往下让一点。 -->
                <StackPanel x:Name="Brand" DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,18,0,26" Background="Transparent">
                    <Border Width="30" Height="30" CornerRadius="8" ClipToBounds="True">
                        <Image Source="avares://WhatPlugin.Desktop/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="WhatPlugin" FontSize="16" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="ExportButton" Classes="Ghost" HorizontalContentAlignment="Left"
                            ToolTip.Tip="导出完整备份，或者把插件评价、混音笔记导出成文件分享给别人">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="导出备份" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportButton" Classes="Ghost" HorizontalContentAlignment="Left" Margin="0,2,0,0"
                            ToolTip.Tip="选一个文件导入：完整备份、别人分享的评价或混音笔记，会自动识别是哪一种">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="TrayArrowUp" Width="16" Height="16" Margin="0,0,10,0"/>
                            <TextBlock Text="导入备份" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 导航项由代码按保存的顺序生成；“设置”固定在最下面。 -->
                        <StackPanel x:Name="NavList"/>
                        <Border Height="1" Background="{DynamicResource Line}" Margin="6,10"/>
                        <StackPanel x:Name="NavFixed"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1" RowDefinitions="38,*,Auto">
            <Border x:Name="TitleStrip" Background="Transparent"/>
            <Panel x:Name="PageHost" Grid.Row="1"/>
            <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,7">
                <DockPanel>
                    <ProgressBar x:Name="ScanProgress" DockPanel.Dock="Right" Width="220" Height="6" MinHeight="6" VerticalAlignment="Center" IsVisible="False"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceActive}"/>
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 新手导览：半透明遮罩挖空当前导航项，气泡在它右边。平时隐藏。 -->
        <Canvas x:Name="TourLayer" Grid.ColumnSpan="2" IsVisible="False" Background="Transparent">
            <Path x:Name="TourShade" Fill="#8C0B1016"/>
            <Border x:Name="TourRing" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="10" IsHitTestVisible="False"/>
            <Panel x:Name="TourBubble" Width="330">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16,18,14" BoxShadow="0 8 28 0 #40000000">
                    <StackPanel>
                        <TextBlock x:Name="TourProgress" FontSize="12" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TourTitle" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TourBody" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TourScanNote" Classes="SmallNote" Text="插件正在后台扫描，进度显示在窗口底部。" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="False"/>
                        <DockPanel Margin="0,16,0,0">
                            <Button x:Name="TourSkipButton" DockPanel.Dock="Left" Content="跳过" Classes="Ghost"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="TourBackButton" Content="上一步" Classes="Ghost" Margin="0,0,6,0"/>
                                <Button x:Name="TourNextButton" Content="下一步" Classes="Primary" MinWidth="76"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Path x:Name="TourArrow" Data="M7,0 L0,8 L7,16 Z" Fill="{DynamicResource Surface}"
                      HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
            </Panel>
        </Canvas>
    </Grid>
</Window>
