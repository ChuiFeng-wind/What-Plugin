<Project Sdk="Microsoft.NET.Sdk">
  <!--
    跨平台界面（Avalonia），先给 Mac 用。Windows 版暂时继续用 WhatPlugin.App（WPF），
    这边功能对齐以后再决定 Windows 是否换过来。界面以外的逻辑都在 WhatPlugin.Core 里，两边共用。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.3.2</Version>
    <Product>WhatPlugin</Product>
    <Company>WhatPlugin</Company>
    <!-- 和 Windows 版的 WhatPlugin.exe 区分开，两边的测试会同时引用。打成 Mac 应用时再改显示名。 -->
    <AssemblyName>WhatPlugin.Desktop</AssemblyName>
    <RootNamespace>WhatPlugin.Desktop</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>..\WhatPlugin.App\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 调用只在 Windows 上有的接口而没有判断平台时，编译直接失败。 -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\WhatPlugin.App\logo.png" Link="Assets\logo.png" />
    <AvaloniaResource Include="..\WhatPlugin.App\app.ico" Link="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WhatPlugin.Core\WhatPlugin.Core.csproj" />
  </ItemGroup>
</Project>
