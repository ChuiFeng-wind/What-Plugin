<Project Sdk="Microsoft.NET.Sdk">
  <!--
    跨平台界面（Avalonia）。Mac 版和 1.3.3 起的 Windows 版都用它；旧的 WhatPlugin.App（WPF）再留一个版本备用
    （installer\build.ps1 -Wpf）。界面以外的逻辑都在 WhatPlugin.Core 里，两边共用。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.3.2</Version>
    <Product>WhatPlugin</Product>
    <Company>WhatPlugin</Company>
    <!-- 程序集名和旧界面的 WhatPlugin 区分开，界面资源地址（avares://WhatPlugin.Desktop/）也用它。
         Windows 安装包里由 installer\build.ps1 把启动程序改名为 WhatPlugin.exe；Mac 应用包里显示名是 WhatPlugin。 -->
    <AssemblyName>WhatPlugin.Desktop</AssemblyName>
    <RootNamespace>WhatPlugin.Desktop</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>..\WhatPlugin.App\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 调用只在 Windows 上有的接口而没有判断平台时，编译直接失败。 -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\WhatPlugin.App\logo.png" Link="Assets\logo.png" />
    <AvaloniaResource Include="..\WhatPlugin.App\app.ico" Link="Assets\app.ico" />
  </ItemGroup>
  <!-- 扫描器由 CMake 单独编译（Windows 是 .exe，Mac 没有扩展名），编译过才带上。 -->
  <ItemGroup Condition="Exists('../../build/scanner/WhatPluginScanner_artefacts/Release/WhatPluginScanner.exe')">
    <None Include="../../build/scanner/WhatPluginScanner_artefacts/Release/WhatPluginScanner.exe" Link="WhatPluginScanner.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../build/scanner/WhatPluginScanner_artefacts/Release/WhatPluginScanner') And !Exists('../../build/scanner/WhatPluginScanner_artefacts/Release/WhatPluginScanner.exe')">
    <None Include="../../build/scanner/WhatPluginScanner_artefacts/Release/WhatPluginScanner" Link="WhatPluginScanner" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WhatPlugin.Core\WhatPlugin.Core.csproj" />
  </ItemGroup>
</Project>
