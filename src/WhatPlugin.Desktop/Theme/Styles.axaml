<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 和 Windows 版 Theme.xaml 一一对应：同样的尺寸、圆角和配色键。 -->

    <!-- 文字 -->
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.PageSubtitle">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,16,0,6"/>
    </Style>
    <Style Selector="TextBlock.SmallNote">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>
    <Style Selector="TextBlock.ColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 面板 -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- 按钮：默认、主操作（Primary）、无边框（Ghost） -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceActive}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Line}"/>
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="Button.Primary">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>
    <Style Selector="Button.Primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
    </Style>

    <Style Selector="Button.Ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.Ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <!-- 左侧导航项：选中时左边一条琥珀色竖线 -->
    <Style Selector="RadioButton.Nav">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="Nav"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Root" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Padding="12,0">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <Border Name="Bar" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource Accent}"
                            HorizontalAlignment="Left" Margin="1,0,0,0" IsVisible="False"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.Nav:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
    </Style>
    <Style Selector="RadioButton.Nav:checked">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="RadioButton.Nav:checked /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
    </Style>
    <Style Selector="RadioButton.Nav:checked /template/ Border#Bar">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="RadioButton.Nav:focus-visible /template/ Border#Root">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- 设置页的主题卡片 -->
    <Style Selector="RadioButton.ThemeCard">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Width" Value="166"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="Theme"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1.5" CornerRadius="10" Padding="8">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.ThemeCard:pointerover /template/ Border#Root">
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
    </Style>
    <Style Selector="RadioButton.ThemeCard:focus-visible /template/ Border#Root">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="RadioButton.ThemeCard:checked /template/ Border#Root">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    </Style>

    <!-- 输入框：和 Windows 版一样的深色底、圆角 8，获得焦点时琥珀色边框 -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftHover}"/>
        <Setter Property="PlaceholderForeground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox:pointerover, TextBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="TextBox.Multiline">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <!-- 推荐栏里的输入框：没有边框，融在卡片里 -->
    <Style Selector="TextBox.Bare">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style Selector="TextBox.Bare:pointerover /template/ Border#PART_BorderElement, TextBox.Bare:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- 下拉框 -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,0,6,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#Background, ComboBox:dropdownopen /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- 分段切换（功能分类 / 音色分类） -->
    <Style Selector="RadioButton.Segment">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="4,5">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                                      FontSize="12.5" Foreground="{TemplateBinding Foreground}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.Segment:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
    </Style>
    <Style Selector="RadioButton.Segment:checked">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="RadioButton.Segment:checked /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="RadioButton.Segment:focus-visible /template/ Border#Root">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- 列表：去掉 Fluent 自带的底色，各自定义选中样式 -->
    <Style Selector="ListBox.Category, ListBox.Plugins">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.Category ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="0,0,0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBox.Category ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="ListBox.Category ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.Category ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- 文件夹树（工程页左侧）：和分类栏一样，选中时琥珀色。 -->
    <Style Selector="TreeView.Folders TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TreeView.Folders TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="TreeView.Folders TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
    </Style>
    <Style Selector="TreeView.Folders TreeViewItem:selected /template/ Border#PART_LayoutRoot, TreeView.Folders TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot, TreeView.Folders TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot, TreeView.Folders TreeViewItem:selected:focus-within /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    </Style>
    <Style Selector="TreeView.Folders TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter, TreeView.Folders TreeViewItem:selected:pointerover /template/ ContentPresenter#PART_HeaderPresenter, TreeView.Folders TreeViewItem:selected:focus /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- 插件表格的行：底部一条细线，悬停变亮，选中时琥珀色底加左边 3px 竖条 -->
    <Style Selector="ListBox.Plugins ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Root" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/>
                    </Border>
                    <Border Name="Bar" Width="3" CornerRadius="0,2,2,0" Background="{DynamicResource Accent}" HorizontalAlignment="Left" IsVisible="False"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Fluent 自带的悬停、选中样式刷的是同名的 PART_ContentPresenter（选中时是系统蓝），这里统一盖成透明，颜色由 Root 负责。 -->
    <Style Selector="ListBox.Plugins ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="ListBox.Plugins ListBoxItem:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
    </Style>
    <Style Selector="ListBox.Plugins ListBoxItem:selected /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    </Style>
    <Style Selector="ListBox.Plugins ListBoxItem:selected /template/ Border#Bar">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- 详情里的分类标签：选中时琥珀色 -->
    <Style Selector="ToggleButton.Chip">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton.Chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="ToggleButton.Chip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.Chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="ToggleButton.Chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Line}"/>
    </Style>

    <!-- 星级：亮的星是琥珀色 -->
    <Style Selector="Button.Star">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource LineStrong}"/>
    </Style>
    <Style Selector="Button.Star:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
    </Style>
    <Style Selector="Button.Star.On">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.Star.On:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
    </Style>

    <!-- 危险操作（移入垃圾桶、卸载）：透明底、红字 -->
    <Style Selector="Button.Danger">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>
    <Style Selector="Button.Danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>
</Styles>
