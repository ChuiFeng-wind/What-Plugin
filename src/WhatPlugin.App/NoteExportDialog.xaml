<Window x:Class="WhatPlugin.App.NoteExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出混音笔记" Width="620" Height="700" Style="{StaticResource DialogWindow}">
    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
        <DockPanel Margin="24,20,24,20">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="导出混音笔记" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource SmallNote}" Margin="0,4,0,14" TextWrapping="Wrap"
                           Text="导出笔记名、文件夹、标签、每一步的插件和应用思路。别人导入后会放进一个单独的文件夹，不会覆盖他自己的笔记。文件不包含工程名、路径、账号和密码。"/>
                <TextBlock Text="你的昵称（可不填）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <TextBox x:Name="AuthorBox" MaxLength="40" AutomationProperties.Name="你的昵称" Tag="别人导入后，文件夹叫“来自 昵称 的笔记”"/>
                <Grid Margin="0,14,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Tag="搜索笔记、标签或插件" AutomationProperties.Name="搜索笔记"/>
                    <Button x:Name="PickAll" Grid.Column="1" Content="全选" Style="{StaticResource GhostButton}" Click="PickAll_Click" Margin="6,0,0,0"/>
                    <Button x:Name="PickNone" Grid.Column="2" Content="取消全选" Style="{StaticResource GhostButton}" Click="PickNone_Click"/>
                    <Button x:Name="PickInvert" Grid.Column="3" Content="反向选择" Style="{StaticResource GhostButton}" Click="PickInvert_Click"/>
                </Grid>
            </StackPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="76" Click="Cancel_Click"/>
                    <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="8,0,0,0" Click="Export_Click" Content="导出"/>
                </StackPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <CheckBox x:Name="IncludeRoutes" Content="一起导出路由（输出、发送、侧链）" IsChecked="True"
                          ToolTip="只保留选中的笔记之间的连线"/>
            </StackPanel>

            <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="6">
                <ListBox x:Name="PickList" ItemContainerStyle="{StaticResource PickItem}" AutomationProperties.Name="混音笔记">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsThreeState="False" Click="Pick_Click"
                                      Margin="{Binding Indent}" AutomationProperties.Name="{Binding Name}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="8,0,0,0"/>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Glyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="{Binding Weight, Mode=OneWay}"/>
                                        <Run Text="{Binding Path, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource Muted}"/>
                                    </TextBlock>
                                </DockPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Border>
</Window>
