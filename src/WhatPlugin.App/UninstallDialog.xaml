<Window x:Class="WhatPlugin.App.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载插件" Width="680" Height="640" Style="{StaticResource DialogWindow}">
    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
        <DockPanel Margin="24,20,24,20">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock x:Name="HeadingText" Text="卸载插件" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource SmallNote}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="找到官方卸载程序时优先用它，操作在官方窗口里完成。本软件自己移动的文件只进回收站。完成后会重新扫描，并报告还剩下哪些文件。卸载掉的插件会记进垃圾桶的“卸载历史”。"/>
            </StackPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="76" Click="Cancel_Click"/>
                    <Button x:Name="StartButton" Style="{StaticResource DangerButton}" MinWidth="110" Margin="8,0,0,0" Click="Start_Click" Content="开始卸载"/>
                </StackPanel>
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="PlanList" Focusable="False" AutomationProperties.Name="要卸载的插件">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,8,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <ComboBox ItemsSource="{Binding Methods}" SelectedIndex="{Binding MethodIndex, Mode=TwoWay}" Margin="0,8,0,0"
                                              AutomationProperties.Name="{Binding MethodName}"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallNote}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock Text="卸载原因（记进卸载历史）" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                    <TextBox Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                                             Tag="比如：太吃 CPU、有更好的替代" AutomationProperties.Name="{Binding ReasonName}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
