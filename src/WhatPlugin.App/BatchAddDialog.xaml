<Window x:Class="WhatPlugin.App.BatchAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhatPlugin.App"
        Title="批量添加已购插件" Width="680" Height="680" Style="{StaticResource DialogWindow}">
    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
        <DockPanel Margin="24,20,24,20">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="批量添加已购插件" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="已经在列表里的插件不会重复添加，只更新填写的内容。" Style="{StaticResource SmallNote}" Margin="0,4,0,14"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="ModePick" GroupName="BatchMode" Style="{StaticResource Segment}" Content="从已安装的插件选" IsChecked="True" Checked="Mode_Checked" Margin="0,0,6,0"/>
                    <RadioButton x:Name="ModePaste" GroupName="BatchMode" Style="{StaticResource Segment}" Content="粘贴文本" Checked="Mode_Checked"/>
                </StackPanel>
            </StackPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="76" Click="Cancel_Click"/>
                    <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="8,0,0,0" Click="Apply_Click" Content="添加"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <DockPanel x:Name="PickPanel">
                    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="统一账号（选填）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <TextBox x:Name="SharedAccount" AutomationProperties.Name="统一账号"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="统一密码（选填）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <local:SecretBox x:Name="SharedPassword" Label="统一密码" ShowCopy="False"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="统一序列号（选填）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <local:SecretBox x:Name="SharedSerial" Label="统一序列号" ShowCopy="False"/>
                        </StackPanel>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PickSearch" TextChanged="PickFilter_Changed" Tag="搜索插件名" AutomationProperties.Name="搜索插件名"/>
                        <ComboBox x:Name="PickVendor" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="PickFilter_Changed" AutomationProperties.Name="厂家"/>
                        <Button x:Name="PickAll" Grid.Column="2" Content="全选" Style="{StaticResource GhostButton}" Click="PickAll_Click" Margin="6,0,0,0"/>
                        <Button x:Name="PickNone" Grid.Column="3" Content="清空" Style="{StaticResource GhostButton}" Click="PickNone_Click"/>
                    </Grid>
                    <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="6">
                        <ListBox x:Name="PickList" ItemContainerStyle="{StaticResource PickItem}" AutomationProperties.Name="已安装的插件">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Checked="Pick_Toggled" Unchecked="Pick_Toggled"
                                              AutomationProperties.Name="{Binding Name}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="已在列表" FontSize="12" Foreground="{DynamicResource Good}" Visibility="{Binding ExistsVisibility}"/>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding Vendor, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource Muted}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <DockPanel x:Name="PastePanel" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SmallNote}"
                                   Text="每行一款，依次是：插件名，厂家，账号，密码，序列号。后面的可以不写。可以直接从表格粘贴，或者粘贴“导出账号”文件的内容。"/>
                        <TextBlock Style="{StaticResource SmallNote}" Foreground="{DynamicResource TextDim}" Margin="0,6,0,0"
                                   FontFamily="Consolas, Microsoft YaHei UI" Text="Pro-Q 4, FabFilter, me@example.com, 我的密码"/>
                    </StackPanel>
                    <TextBox x:Name="PasteBox" Style="{StaticResource MultilineBox}" TextWrapping="NoWrap" AcceptsTab="True" TextChanged="PasteBox_TextChanged"
                             FontFamily="Consolas, Microsoft YaHei UI" AutomationProperties.Name="粘贴账号文本"/>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
