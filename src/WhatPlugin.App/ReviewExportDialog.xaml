<Window x:Class="WhatPlugin.App.ReviewExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出评价" Width="620" Height="680" Style="{StaticResource DialogWindow}">
    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
        <DockPanel Margin="24,20,24,20">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="导出评价" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource SmallNote}" Margin="0,4,0,14" TextWrapping="Wrap"
                           Text="别人导入后，会在插件详情里看到你的昵称和评价。文件不包含账号、密码、序列号、价格、工程名和路径。"/>
                <TextBlock Text="你的昵称" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <TextBox x:Name="AuthorBox" MaxLength="40" TextChanged="Author_Changed" AutomationProperties.Name="你的昵称" Tag="别人看到的名字"/>
                <Grid Margin="0,14,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Tag="搜索插件名或厂家" AutomationProperties.Name="搜索插件"/>
                    <Button x:Name="PickAll" Grid.Column="1" Content="全选" Style="{StaticResource GhostButton}" Click="PickAll_Click" Margin="6,0,0,0"/>
                    <Button x:Name="PickNone" Grid.Column="2" Content="清空" Style="{StaticResource GhostButton}" Click="PickNone_Click"/>
                </Grid>
            </StackPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="76" Click="Cancel_Click"/>
                    <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="8,0,0,0" Click="Export_Click" Content="导出"/>
                </StackPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <TextBlock Text="一起导出（可选）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="IncludeUsage" Content="使用次数" Margin="0,0,18,0" ToolTip="只有次数，不含工程名"/>
                    <CheckBox x:Name="IncludeCategories" Content="功能分类" Margin="0,0,18,0"/>
                    <CheckBox x:Name="IncludeMix" Content="混音属性"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="6">
                <ListBox x:Name="PickList" ItemContainerStyle="{StaticResource PickItem}" AutomationProperties.Name="写过评价的插件">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Checked="Pick_Toggled" Unchecked="Pick_Toggled"
                                      AutomationProperties.Name="{Binding Name}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Stars}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="8,0,0,0"/>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                        <Run Text="{Binding Vendor, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource Muted}"/>
                                    </TextBlock>
                                </DockPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Border>
</Window>
