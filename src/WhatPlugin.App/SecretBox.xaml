<UserControl x:Class="WhatPlugin.App.SecretBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="Copy_Click" Margin="2,0,0,0" ToolTip="复制，30 秒后自动清除"/>
        <Button x:Name="RevealButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE890;" Click="Reveal_Click" Margin="4,0,0,0" ToolTip="显示或隐藏"/>
        <Grid>
            <PasswordBox x:Name="Hidden" PasswordChanged="Hidden_PasswordChanged"/>
            <TextBox x:Name="Plain" Visibility="Collapsed" TextChanged="Plain_TextChanged"/>
        </Grid>
    </DockPanel>
</UserControl>
