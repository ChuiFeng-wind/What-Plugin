<Window x:Class="WhatPlugin.App.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 WhatPlugin" Width="640" SizeToContent="Height" Style="{StaticResource DialogWindow}">
    <Window.Resources>
        <Style x:Key="FeatureCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,14,14,12"/>
            <Setter Property="Background" Value="{DynamicResource Bg1}"/>
        </Style>
        <Style x:Key="FeatureIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
        <StackPanel Margin="28,26,28,22">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="11" AutomationProperties.Name="WhatPlugin 标志">
                    <Border.Background>
                        <ImageBrush ImageSource="logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border.Background>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="欢迎使用 WhatPlugin" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="给音乐人和混音师的插件管理工具" Foreground="{DynamicResource TextDim}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <UniformGrid Columns="3" Margin="0,22,0,0">
                <Border Style="{StaticResource FeatureCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE8F1;"/>
                        <TextBlock Text="整理插件" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource SmallNote}" Margin="0,4,0,0" Text="扫描本机插件，自动认出厂家和分类，写笔记、打分。"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FeatureCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE8B7;"/>
                        <TextBlock Text="分析工程" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource SmallNote}" Margin="0,4,0,0" Text="查出工程缺了哪些插件，哪些插件一直闲着。"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FeatureCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE71B;"/>
                        <TextBlock Text="记下经验" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource SmallNote}" Margin="0,4,0,0" Text="把效果链记成混音笔记，买过、卸过的都有记录。"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="16,14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="第一步：扫描插件" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource SmallNote}" Foreground="{DynamicResource TextDim}" Margin="0,4,0,0"
                               Text="先扫描 VST3 插件，大概要几分钟，扫描时可以继续看导览。扫描只读取插件清单，不打开插件界面，不弹授权窗口。VST2 插件要在“设置”里添加所在的文件夹。"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SmallNote}" Margin="2,12,0,0"
                       Text="所有数据只保存在这台电脑上。工程文件只读不改，不读取也不修改 iLok / PACE 授权。"/>

            <DockPanel Margin="0,22,0,0">
                <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="跳过" Style="{StaticResource GhostButton}" IsCancel="True" Click="Skip_Click"
                        ToolTip="以后可以在“设置”里重新查看新手指引"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="TourButton" Content="只看导览" Style="{StaticResource GhostButton}" Click="Tour_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Scan_Click" Padding="16,0"
                            AutomationProperties.Name="开始扫描并参观">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0"/>
                            <TextBlock Text="开始扫描并参观"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
