<Window x:Class="WhatPlugin.App.WavesToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waves 完全卸载工具" Width="880" Height="760" Style="{StaticResource DialogWindow}">
    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
        <DockPanel Margin="24,20,24,20">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock x:Name="HeadingText" Text="Waves 完全卸载工具" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubheadText" Style="{StaticResource SmallNote}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="这一页只读取，不会改动任何内容。点“开始卸载”后才会动手。工具只负责卸载和清理，不会生成、修改或修复任何授权。"/>
                <TextBlock x:Name="TestModeText" Visibility="Collapsed" Foreground="{DynamicResource Danger}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="测试模式：只操作测试文件夹，不会碰真实的 Waves。"/>
            </StackPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CloseButton" Content="关闭" MinWidth="76" Click="Close_Click"/>
                    <Button x:Name="StartButton" Style="{StaticResource DangerButton}" MinWidth="110" Margin="8,0,0,0" Click="Start_Click" Content="开始卸载"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RecheckButton" Content="重新检查" Style="{StaticResource GhostButton}" Click="Recheck_Click"/>
                    <Button x:Name="ExportButton" Content="查看预演清单" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="Export_Click"/>
                    <Button x:Name="CentralButton" Content="打开 Waves Central" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="Central_Click"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <ScrollViewer x:Name="SurveyPanel" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="0,0,10,0">
                        <Border x:Name="PendingPanel" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10" Visibility="Collapsed">
                            <DockPanel>
                                <Button x:Name="RestorePendingButton" DockPanel.Dock="Right" Content="恢复这份备份" VerticalAlignment="Center" Margin="12,0,0,0" Click="RestorePending_Click"/>
                                <TextBlock x:Name="PendingText" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="检查结果" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextDim}" LineHeight="20"/>
                                <TextBlock x:Name="BlockerText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Danger}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,4,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <RadioButton x:Name="StandardRadio" Style="{StaticResource Segment}" GroupName="WavesPreset" Content="标准清理" Checked="Preset_Checked" AutomationProperties.Name="标准清理"/>
                                <RadioButton x:Name="FullRadio" Style="{StaticResource Segment}" GroupName="WavesPreset" Content="完全清理" Margin="6,0,0,0" Checked="Preset_Checked" AutomationProperties.Name="完全清理"/>
                            </StackPanel>
                            <TextBlock Text="清理项" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource SmallNote}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="勾选表示清理，不勾选表示保留。保留项会先备份，因为 MSI 卸载时也可能把它们删掉，卸载后再放回原位。"/>

                        <ItemsControl x:Name="CategoryList" Focusable="False" AutomationProperties.Name="清理项">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Clean, Mode=TwoWay}" IsEnabled="{Binding CanChange}" VerticalAlignment="Top" Margin="0,2,10,0"
                                                      AutomationProperties.Name="{Binding AutomationName}"/>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Action}" Style="{StaticResource SmallNote}" Margin="12,0,0,0"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallNote}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,2,0,10">
                            <StackPanel>
                                <TextBlock Text="标准目录以外的 WaveShell" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ExtraNote" Style="{StaticResource SmallNote}" TextWrapping="Wrap" Margin="0,4,0,0" Text="正在搜索各磁盘…"/>
                                <ItemsControl x:Name="ExtraList" Focusable="False" Margin="0,6,0,0" AutomationProperties.Name="其他 WaveShell">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,3,0,3" AutomationProperties.Name="{Binding Path}">
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="BackupFolderButton" DockPanel.Dock="Right" Content="更改" Style="{StaticResource GhostButton}" Click="BackupFolder_Click" VerticalAlignment="Top"/>
                                    <TextBlock Text="备份位置" FontWeight="SemiBold"/>
                                </DockPanel>
                                <TextBlock x:Name="BackupText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextDim}"/>
                                <TextBlock x:Name="BackupWarning" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Danger}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="授权" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource SmallNote}" TextWrapping="Wrap" Margin="0,4,0,8"
                                           Text="如果你有官方授权，请先用“打开 Waves Central”把授权移回云端。没有需要处理的授权时也可以继续，但卸载后恢复的授权文件不保证还能用。"/>
                                <CheckBox x:Name="LicenseCheck" Content="我已经处理好授权，或确认不需要处理" Checked="Selection_Changed" Unchecked="Selection_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <DockPanel x:Name="RunPanel" Visibility="Collapsed">
                    <ItemsControl x:Name="StepList" DockPanel.Dock="Top" Focusable="False" AutomationProperties.Name="卸载步骤">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Style="{StaticResource SmallNote}" Margin="12,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallNote}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="PromptPanel" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,12" Margin="0,6,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="PromptText" TextWrapping="Wrap" LineHeight="20"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button x:Name="PromptHelpButton" Content="打开微软修复工具页面" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="PromptHelp_Click" Visibility="Collapsed"/>
                                <Button x:Name="PromptSecondButton" MinWidth="76" Click="PromptSecond_Click"/>
                                <Button x:Name="PromptPrimaryButton" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="8,0,0,0" Click="PromptPrimary_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="ReportBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Visibility="Collapsed" VerticalContentAlignment="Top"
                             Margin="0,6,0,0" AutomationProperties.Name="卸载结果"/>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
